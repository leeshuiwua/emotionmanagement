{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "src/server",
    "outDir": "dist/server",
    "types": ["node"],
    "sourceMap": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/server/**/*.ts"],
  "exclude": ["tests"]
}

