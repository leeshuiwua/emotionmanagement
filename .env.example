NODE_ENV=production
HOST=127.0.0.1
PORT=3102
DATABASE_PATH=./data/guanxinjing.db
PUBLIC_BASE_URL=https://example.com:3002
# 32-byte key encoded as base64. Generate: openssl rand -base64 32
MASTER_KEY=
# auto: HTTPS 反代时使用 Secure，HTTP 直连时允许登录；公网强制 HTTPS 可设为 true
COOKIE_SECURE=auto
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
